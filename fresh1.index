<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Fresh — Premium Mango</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --accent-1:#ff9f1c;
    --accent-2:#ff7a00;
    --bg-1:#fff4e5;
    --bg-2:#ffe3b8;
    --glass: rgba(255,255,255,0.35);
    --dark: #4b3418;
  }

  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;
    font-family:"Montserrat",sans-serif;
    background: linear-gradient(180deg,var(--bg-1),var(--bg-2));
    overflow-x:hidden;
    color:var(--dark);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    --page-fade:0;
    animation: pageFade .9s ease forwards;
  }

  @keyframes pageFade{
    from{opacity:0; transform: translateY(8px)}
    to{opacity:1; transform:none}
  }

  header{
    position:sticky; top:0; z-index:120;
    padding:16px 24px;
    display:flex; align-items:center; justify-content:space-between;
    background: linear-gradient(90deg, rgba(255,159,28,0.95), rgba(255,122,0,0.9));
    color:white;
    box-shadow:0 6px 20px rgba(255,140,0,0.18);
    backdrop-filter: blur(6px);
  }
  .brand{font-weight:900; font-size:20px; letter-spacing:0.6px}
  nav a{color:white; text-decoration:none; margin-left:18px; font-weight:700}
  nav a:hover{opacity:.95; transform:translateY(-2px)}

  /* HERO */
  .hero{
    max-width:1200px;
    margin:36px auto;
    padding:36px 28px;
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:40px;
    align-items:center;
    position:relative;
  }

  /* decorative moving bubbles */
  .bubbles{
    position:absolute; inset:0; pointer-events:none; z-index:0; overflow:hidden;
  }
  .bubble{
    position:absolute; border-radius:50%; opacity:0.12; transform:translateZ(0);
    animation: bubbleFloat linear infinite;
    filter: blur(8px);
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.95), rgba(255,255,255,0.1));
    mix-blend-mode: screen;
  }
  @keyframes bubbleFloat{
    from{transform: translateY(40vh) scale(.7)}
    to{transform: translateY(-30vh) scale(1)}
  }

  /* left: hero image with splashes and slices */
  .visual{
    position:relative; z-index:5; display:flex; justify-content:center; align-items:center;
    perspective:1000px;
  }

  .splash{
    position:absolute; width:520px; height:520px; border-radius:50%;
    background: radial-gradient(circle at 30% 35%, rgba(255,200,120,0.95), rgba(255,150,40,0.08) 35%, rgba(255,200,100,0.02) 60%);
    filter: blur(28px) saturate(1.05);
    transform: translateY(20px) scale(.9);
    z-index:2;
    pointer-events:none;
    mix-blend-mode: screen;
    transition: transform .4s ease;
  }

  .bottle-wrap{
    position:relative; z-index:6;
    width:100%; max-width:420px;
    display:flex; justify-content:center; align-items:center;
    transform-style: preserve-3d;
    transition: transform .35s ease;
  }

  .bottle{
    width:100%; border-radius:22px; display:block;
    box-shadow: 0 18px 50px rgba(255,140,0,0.25), 0 6px 20px rgba(80,40,0,0.06);
    transform-origin:center;
    transition: transform .35s cubic-bezier(.2,.9,.2,1);
  }
  .bottle:hover{ transform: translateY(-8px) rotateZ(-1deg) scale(1.02) }

  /* mango slices (repeated absolute images) */
  .slice{
    position:absolute; width:90px; height:90px; object-fit:cover; border-radius:14px;
    transform-origin:center center;
    pointer-events:none;
    will-change:transform, opacity;
    filter: drop-shadow(0 6px 12px rgba(0,0,0,0.12)) saturate(1.05) contrast(1.02);
    mix-blend-mode: normal;
  }

  /* text column */
  .content{
    z-index:8; padding:8px 6px;
  }
  .kicker{display:inline-block; font-weight:900; color:var(--accent-2); background:rgba(255,255,255,0.85); padding:8px 12px; border-radius:999px; box-shadow:0 6px 20px rgba(255,150,40,0.12); margin-bottom:18px; font-size:13px}
  h1{
    margin:0 0 18px 0;
    font-size:48px; line-height:1.02;
    color: #ff7a00; text-shadow: 0 8px 24px rgba(255,140,0,0.12);
    font-weight:900;
  }
  p.lead{color: #5a3c16; font-size:18px; line-height:1.7; margin:0 0 18px; max-width:650px}

  /* info cards */
  .cards{display:flex; gap:12px; flex-wrap:wrap; margin-top:8px}
  .card{
    background:linear-gradient(180deg, rgba(255,255,255,0.7), rgba(255,255,255,0.45));
    border-radius:14px; padding:14px 16px; min-width:170px;
    box-shadow: 0 10px 30px rgba(255,145,0,0.06); border-left:6px solid var(--accent-1);
    backdrop-filter: blur(8px);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .card:hover{ transform: translateY(-6px); box-shadow: 0 18px 48px rgba(255,140,0,0.14) }

  .card strong{display:block; color:var(--accent-2); font-weight:800; margin-bottom:6px}

  /* buttons */
  .actions{margin-top:22px}
  .btn{
    display:inline-block; padding:14px 26px; border-radius:40px; text-decoration:none; font-weight:800;
    background: linear-gradient(90deg, var(--accent-1), var(--accent-2));
    color:white; box-shadow:0 8px 30px rgba(255,120,20,0.22); margin-right:12px;
    position:relative; overflow:hidden;
  }
  /* golden shine */
  .btn:after{
    content:""; position:absolute; left:-20%; top:-60%; width:40%; height:180%;
    background:linear-gradient(120deg, rgba(255,255,255,0.15), rgba(255,255,255,0.55), rgba(255,255,255,0.15));
    transform:rotate(25deg); transition: transform .7s ease;
    pointer-events:none;
  }
  .btn:hover:after{ transform: translateX(300%) rotate(25deg) }
  .btn.secondary{ background:transparent; color:var(--accent-2); border:2px solid rgba(255,138,0,0.12) }

  /* responsive */
  @media (max-width:880px){
    .hero{grid-template-columns:1fr; padding:28px 18px}
    .splash{display:none}
    h1{font-size:34px}
    .bubble{display:none}
  }

  /* little floating animations for slices */
  @keyframes floatX{
    from{transform: translateY(0) rotate(0deg) scale(1)}
    50%{transform: translateY(-18px) rotate(12deg) scale(.98)}
    to{transform: translateY(0) rotate(0deg) scale(1)}
  }

  /* small shadow ring */
  .ground-glow{
    position:absolute; bottom:-20px; width:260px; height:120px; border-radius:50%;
    background: radial-gradient(closest-side, rgba(255,170,0,0.14), rgba(255,160,0,0.02));
    filter: blur(18px); z-index:3; left:calc(50% - 130px)
  }

  /* footer stub */

  footer{ max-width:1200px; margin:32px auto; padding:20px; color:#6b4a24; text-align:center; font-size:14px}
</style>
</head>
<body>

<header>
  <div class="brand">Fresh</div>
  <nav aria-label="Primary">
    <a href="#">Home</a>
    <a href="products.html">Products</a>
    <a href="video.html">Video</a>
  </nav>
</header>

<section class="hero" id="hero">
  <div class="bubbles" id="bubbles"></div>

  <div class="visual" id="visual">
    <div class="splash" id="splash" aria-hidden="true"></div>

    <div class="bottle-wrap" id="bottleWrap">
      <img src="float.jpeg" alt="Premium Mango Drink" class="bottle" id="bottle">
      <div class="ground-glow" aria-hidden="true"></div>
    </div>

    <!-- slices will be injected here by JS -->
  </div>

  <div class="content">
    
    <h1>HEALTHY JUICE </h1>
    <p class="lead">Watermelon, passion fruit, lime, lychee, blueberries, pineapple, banana, papaya, mango, and longan., cold-pressed with real fruit — no additives. Bright, refreshing, and made to glow from within. Taste the sun in every sip.fruit-infused beverage which often contains real fruit pieces as seen in the image. The specific ingredients can vary depending on the flavo</p>

    <div class="cards" role="list">
      <div class="card" role="listitem">
        <strong>Ingredients</strong>
        Mango • Kiwi • Lemon • Honey • Mint
      </div>
      <div class="card" role="listitem">
        <strong>Storage</strong>
        Keep chilled (2–5°C), best within 3 days.
      </div>
      <div class="card" role="listitem">
        <strong>Benefits</strong>
        Boosts immunity • Fresh hydration • Natural glow
      </div>
    </div>

    <div class="actions">
      <a class="btn" href="products.html">Explore Products</a>
      <a class="btn secondary" href="video.html">Watch Video</a>
    </div>
  </div>
</section>

<footer>
  © <span id="year"></span> Fresh — Crafted with real fruit.
</footer>

<script>
  // small helper to randomize numbers
  const rnd = (min,max) => Math.random()*(max-min)+min;

  // create animated background bubbles
  const bubblesRoot = document.getElementById('bubbles');
  const bubbleCount = 10;
  for(let i=0;i<bubbleCount;i++){
    const b = document.createElement('div');
    b.className='bubble';
    const size = rnd(80,260);
    b.style.width = size+'px';
    b.style.height = size+'px';
    b.style.left = rnd(-10,90)+'%';
    b.style.top = rnd(10,90)+'%';
    b.style.opacity = rnd(0.06,0.18);
    b.style.animationDuration = rnd(14,28)+'s';
    b.style.background = `radial-gradient(circle at 35% 30%, rgba(255,255,255,0.9), rgba(255,255,255,0.04))`;
    bubblesRoot.appendChild(b);
  }

  
  // - slice.png (the uploaded fruit image used for floating slices)
</script>
</body>
</html>
